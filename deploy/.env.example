# privasoc+ deployment. Copy to .env; never commit .env.
# Paths of the two repositories, relative to this folder or absolute.
PRIVASOC_DIR=../../privasoc
SOVGATE_DIR=../../CyberAI/sovereign-llm-gateway

# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SOVGATE_HMAC_SECRET=
SOVGATE_PRIVASOC_KEY=
PRIVASOC_API_TOKEN=

# Local model runs inside the isolated stack. Pin OLLAMA_IMAGE to a digest for replay.
LOCAL_MODEL=qwen3:8b
OLLAMA_IMAGE=ollama/ollama:latest
SYSLOG_BIND=127.0.0.1
PRIVASOC_BIND=127.0.0.1

# Optional frontier profile + compose.frontier.yml only. The base stack is local.
EXTERNAL_API_KEY=
FRONTIER_MODEL=gpt-4o-mini
