# Copy to .env and fill in. Never commit .env.

# Key for consistent pseudonyms (min. 16 bytes). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SOVGATE_HMAC_SECRET=

# API key of the external, OpenAI-compatible provider
EXTERNAL_API_KEY=

SOVGATE_POLICY=config/policy.yaml
SOVGATE_AUDIT_PATH=audit/audit.jsonl
SOVGATE_VAULT_TTL=3600

# Optional: require a bearer key on every /v1 call and derive the tenant from it.
# Format: key:tenant[,key:tenant]. Generate keys like the HMAC secret.
SOVGATE_API_KEYS=
